---
interface Props {
    href: string;
}
const { href } = Astro.props;
const id = href.replace('#','');
---
<a data-section={id} href={href} class="px-3 py-1.5 rounded-full hover:text-zinc-900 dark:hover:text-white transition-all">
    <slot />
</a>

<script>
    const links = document.querySelectorAll('a[data-section]');
    const sections = document.querySelectorAll('section[id]');

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const id = entry.target.getAttribute('id');
            const link = document.querySelector(`a[data-section="${id}"]`);
            if(entry.isIntersecting){
                links.forEach(l => l.classList.remove('text-zinc-900', 'dark:text-white', 'bg-white', 'dark:bg-zinc-800/80'));
                link?.classList.add('text-zinc-900', 'dark:text-white', 'bg-white', 'dark:bg-zinc-800/80');
            }
        });
    }, {rootMargin: "-40% 0px -60% 0px"})
    sections.forEach(section => observer.observe(section));
</script>
