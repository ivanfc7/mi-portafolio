---
import { Sun, Moon } from "lucide-astro";
---
<button type="button" id="dark-mode-toggle" aria-label="Alternar modo oscuro y claro"
  class="p-2 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/80 text-zinc-700 dark:text-zinc-300 hover:border-emerald-500/40 hover:text-emerald-500 transition-all cursor-pointer flex items-center justify-center">
  {/* Icono de Sol para cuando esté en Modo Oscuro */}
  <Sun class="w-4 h-4 hidden dark:block text-zinc-300 hover:text-emerald-400" />
  {/* Icono de Luna para cuando esté en Modo Claro */}
  <Moon class="w-4 h-4 block dark:hidden text-zinc-700 hover:text-emerald-600" />
</button>