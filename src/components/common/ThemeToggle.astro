---
import { Sun, Moon } from "lucide-astro";
---
<button type="button" id="dark-mode-toggle" aria-label="Alternar modo oscuro y claro"
class="px-2.5 py-1.5 rounded-lg border border-(--border) bg-(--bg-surface) text-(--text-muted) hover:border-(--accent-border) hover:text-(--accent) transition-all cursor-pointer flex items-center justify-center">
  {/* Icono de Sol para cuando esté en Modo Oscuro */}
  <Sun class="w-4 h-4 icon-sun hidden dark:block text-zinc-300 hover:text-(--accent)" />
  {/* Icono de Luna para cuando esté en Modo Claro */}
  <Moon class="w-4 h-4 icon-moon block dark:hidden text-(--text-muted) hover:text-(--accent)" />
</button>

<script is:inline>
  const btn = document.getElementById('dark-mode-toggle');

  const updateTheme = () => {
    const theme = localStorage.getItem('theme');
    if(theme === 'dark'){
      document.documentElement.classList.add('dark');
      console.log('Se cambio a tema oscuro');
    }else{
      document.documentElement.classList.remove('dark');
      console.log('Se cambio a tema claro');
    }
  }

  updateTheme();

  btn.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark': 'light');
  });
</script>