---
import { Github, Linkedin, Instagram ,MessageSquare, Mail, MapPin, ArrowUp, Code2 } from "lucide-astro";

const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: "GitHub", url: "https://github.com/ivanfc7", icon: Github },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/ivan-f-calle/", icon: Linkedin },
  { name: "WhatsApp", url: "https://wa.me/76440920", icon: MessageSquare },
  { name: "Email", url: "mailto:ivanflorescalle128@gmail.com", icon: Mail },
  { name: "Instagram", url: "https://www.instagram.com/ivanf_calle", icon: Instagram}
];

const navLinks = [
  { name: "Inicio", href: "#top" },
  { name: "Sobre mí", href: "#about-me" },
  { name: "Educación", href: "#education" },
  { name: "Experiencia", href: "#experience" },
  { name: "Habilidades", href: "#skills"},
  { name: "Proyectos", href: "#projects" },
];
---

<footer class="w-full border-t border-(--border)/5 bg-(--bg-surface)/40 backdrop-blur-md pt-16 pb-12 mt-20">
  <div class="max-w-4xl mx-auto px-4 flex flex-col gap-12">
    
    {/* Bloque Superior: Marca / Mensaje + Navegación + Redes */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      {/* Columna 1: Presentación Breve */}
      <div class="lg:col-span-2 space-y-3">
        <div class="flex items-center gap-2 text-(--accent) font-bold text-lg">
          <Code2 class="w-5 h-5" />
          <span>Ingeniería de Sistemas</span>
        </div>
        <p class="text-xs sm:text-sm text-(--text-muted) max-w-sm leading-relaxed">
          Especializado en desarrollo web y la creatividad para la resolución de problemas. Siempre abierto a nuevas oportunidades, aprendizaje y colaboraciones.
        </p>
        <div class="flex items-center gap-2 text-xs text-(--text-muted) font-mono pt-1">
          <MapPin class="w-3.5 h-3.5 text-(--accent)" />
          <span>Cochabamba, Bolivia</span>
        </div>
      </div>

      {/* Columna 2: Enlaces Rápidos */}
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-(--text) font-bold">Navegación</h4>
        <ul class="space-y-2 text-xs text-(--text-muted)">
          {navLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="hover:text-(--accent) transition-colors inline-block py-0.5"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Columna 3: Redes Sociales */}
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-wider text-(--text) font-bold">Conectemos</h4>
        <div class="flex flex-wrap gap-2">
          {socialLinks.map((social) => {
            const Icon = social.icon;
            return (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="p-2.5 rounded-xl border border-(--border) bg-(--bg) hover:bg-(--accent)/10 hover:border-(--accent)/40 text-(--text-muted) hover:text-(--accent) transition-all cursor-pointer group"
              >
                <Icon class="w-4 h-4 group-hover:scale-110 transition-transform" />
              </a>
            );
          })}
        </div>
      </div>

    </div>

    {/* Separador Interno */}
    <div class="h-px w-full bg-(--border)/30 dark:bg-white/5"></div>

    {/* Bloque Inferior: Copyright + Botón Scroll */}
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-(--text-muted)">
      
      <div class="flex items-center gap-1 font-mono">
        <span>© {currentYear}</span>
        <span>•</span>
        <span>Ivan Flores Calle</span>
      </div>

      {/* Botón Volver Arriba */}
      <button 
        id="scroll-to-top"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl border border-(--border)/40 dark:border-white/5 bg-(--bg) hover:bg-(--bg-card) hover:text-(--text) hover:border-(--accent)/30 transition-all cursor-pointer font-mono text-xs"
      >
        <span>Volver arriba</span>
        <ArrowUp class="w-3.5 h-3.5 text-(--accent)" />
      </button>

    </div>

  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', initScroll);
  document.addEventListener('DOMContentLoaded', initScroll);

  function initScroll() {
    const btnTop = document.getElementById('scroll-to-top');
    btnTop?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>