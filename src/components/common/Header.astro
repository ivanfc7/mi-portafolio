---
import PaletteToggle from "./PaletteToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { Languages } from "lucide-astro";
import NavLink from "./NavLink.astro";
---
<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-(--bg-header) transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="text-lg font-bold tracking-tight text-(--text) hover:text-(--accent) transition-colors flex items-center gap-1.5">
      Ivan F. Calle<span class="text-(--accent) font-extrabold">.</span>
    </a>

    {/* Navegación Principal */}
    <nav class="hidden md:flex items-center gap-1bg-(--bg-surface) p-1.5 rounded-full border border-(--border) text-sm font-medium text-(--text-muted)">
        <NavLink href="#home">Inicio</NavLink>
        <NavLink href="#about-me">Sobre mí</NavLink>
        <NavLink href="#education">Educación</NavLink>
        <NavLink href="#experience">Experiencia</NavLink>
        <NavLink href="#skills">Habilidades</NavLink>
        <NavLink href="#projects">Proyectos</NavLink>
    </nav>

    {/* Barra de Controles */}
    <div class="flex items-center gap-2 sm:gap-3">
      {/* 1. Selector de Idioma (ES / EN) */}
      <button type="button" aria-label="Cambiar idioma"
        class="flex items-center gap-1.5 text-xs font-mono px-2.5 py-1.5 rounded-lg border border-(--border) bg-(--bg-surface) text-(--text-muted) hover:border-(--accent-border) hover:text-(--accent) transition-all cursor-pointer">
        <Languages class="w-3.5 h-3.5 text-(--accent)" />
        <span>ES</span>
      </button>

      {/* 2. Selector de Paleta de Color de Acento */}
      <PaletteToggle />

      {/* 3. Conmutador de Modo Oscuro / Claro */}
      <ThemeToggle />
    </div>
  </div>
</header>