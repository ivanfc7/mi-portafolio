---
import { Github, ExternalLink, ArrowRight, Sparkles } from "lucide-astro";
import { LIST_PROJECTS } from "../../data/proyects";
---

<section id="projects" class="py-16 flex flex-col items-start gap-8">
    <div class="space-y-2">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-(--accent)">
          Proyectos
        </h2>
        <p class="text-sm text-(--text-muted)">
            Mis proyectos realizados los ultimos años.
        </p>
    </div>

  {/* Rejilla de Proyectos */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
    {LIST_PROJECTS.map((project) => (
      <article class="p-5 rounded-2xl border border-(--border)/40 dark:border-white/5 bg-(--bg-surface) hover:bg-(--bg-card) hover:border-(--accent)/40 transition-all duration-300 shadow-xs flex flex-col justify-between gap-4 group overflow-hidden">
        
        {/* Vista Previa Visual (Imagen / Video en Hover) */}
        <div class="relative w-full h-48 sm:h-52 rounded-xl overflow-hidden bg-(--bg) border border-(--border)/30 dark:border-white/5">
          {project.previewVideo ? (
            <video 
              src={project.previewVideo} 
              poster={project.image}
              muted 
              loop 
              playsinline
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onmouseenter="this.play()"
              onmouseleave="this.pause(); this.currentTime = 0;"
            />
          ) : (
            <img 
              src={project.image} 
              alt={project.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          )}

          {/* Badge 'Destacado' en la esquina */}
          <div class="absolute top-3 right-3 px-2.5 py-1 rounded-lg border border-black/10 bg-black/60 backdrop-blur-md text-white text-[10px] font-mono flex items-center gap-1">
            <Sparkles class="w-3 h-3 text-(--accent)" />
            Featured
          </div>
        </div>

        {/* Detalles del Proyecto */}
        <div class="space-y-2">
          <h3 class="text-lg font-bold text-(--text) group-hover:text-(--accent) transition-colors">
            {project.title}
          </h3>
          <p class="text-xs sm:text-sm text-(--text-muted) leading-relaxed line-clamp-2">
            {project.description}
          </p>
        </div>

        {/* Badges de Tecnologías */}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {project.tags.map((tag) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-(--bg) border border-(--border)/30 dark:border-white/5 text-(--text-muted)">
              {tag}
            </span>
          ))}
        </div>

        {/* Acciones: GitHub, Demo & Ver Más */}
        <div class="flex items-center justify-between pt-3 border-t border-(--border)/30 dark:border-white/5 mt-1">
          <div class="flex items-center gap-2">
            {project.githubUrl ? (
              <a 
                href={project.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Ver código en GitHub"
                class="p-2 rounded-lg border border-(--border)/30 dark:border-white/5 bg-(--bg) text-(--text-muted) hover:text-(--text) hover:border-(--accent)/40 transition-all"
              >
                <Github class="w-4 h-4" />
              </a>
            ) : (
              <span class="text-[11px] font-mono text-(--text-muted)/60 italic px-1">Código Privado</span>
            )}

            {project.demoUrl && (
              <a 
                href={project.demoUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                aria-label="Ver Demo en Vivo"
                class="p-2 rounded-lg border border-(--border)/30 dark:border-white/5 bg-(--bg) text-(--text-muted) hover:text-(--accent) hover:border-(--accent)/40 transition-all"
              >
                <ExternalLink class="w-4 h-4" />
              </a>
            )}
          </div>

          <a 
            href={`/proyectos/${project.id}`} 
            class="text-xs font-semibold text-(--accent) hover:underline flex items-center gap-1"
          >
            Detalles
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

      </article>
    ))}
  </div>

  {/* Botón Inferior Grande para Ir a la Ruta de Todos los Proyectos */}
  <div class="w-full flex justify-center pt-4">
    <a
      href="/all-projects"
      class="px-6 py-3 rounded-xl border border-(--border)/40 dark:border-white/10 bg-(--bg-surface) hover:bg-(--bg-card) text-(--text) hover:border-(--accent)/40 text-sm font-semibold transition-all duration-300 shadow-xs flex items-center gap-2 group"
    >
      <span>Explorar todos los proyectos</span>
      <ArrowRight class="w-4 h-4 text-(--accent) transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</section>