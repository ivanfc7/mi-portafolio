---
import { WORK_EXPERIENCES } from "../../data/experience";
import { Calendar, MapPin, Building2 } from "lucide-astro";
---

<section id="experience" class="py-16 flex flex-col items-start gap-8">
  <div class="space-y-2">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-(--accent)">
      Experiencia Laboral
    </h2>
    <p class="text-sm text-(--text-muted)">
      Mi recorrido profesional en instituciones.
    </p>
  </div>

  {/* Estructura de Línea de Tiempo */}
  <div class="relative border-l border-(--border) ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-8 w-full max-w-3xl">
    {WORK_EXPERIENCES.map((job) => (
      <div class="relative group">
        
        {/* Punto en la línea del tiempo */}
        <div class="absolute -left-7.75 sm:-left-9.75 top-1.5 w-3.5 h-3.5 rounded-full bg-(--bg) border-2 border-(--accent) group-hover:scale-125 transition-transform duration-300">
          {job.isCurrent && (
            <span class="absolute -inset-1 rounded-full bg-(--accent) opacity-40 animate-ping"></span>
          )}
        </div>

        {/* Tarjeta de Trabajo */}
        <div class="p-5 sm:p-6 rounded-2xl border border-(--border) bg-(--bg-surface) hover:bg-(--bg-card) transition-all duration-300">
          
         {/* Encabezado: Logo, Cargo, Empresa y Fechas */}
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
  <div class="flex items-start sm:items-center gap-3.5">
    
    {/* Contenedor del Logo de la Institución */}
    {job.logo ? (
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl border border-(--border)/40 dark:border-white/10 bg-(--bg) p-2 flex items-center justify-center shrink-0 shadow-xs group-hover:border-(--accent)/40 transition-colors">
        <img 
          src={job.logo} 
          alt={`Logo de ${job.company}`} 
          class="w-full h-full object-contain"
          loading="lazy"
        />
      </div>
    ) : (
      /* Fallback si el trabajo no tiene logo guardado aún */
      <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl border border-(--border)/40 dark:border-white/10 bg-(--accent)/10 text-(--accent) p-2 flex items-center justify-center shrink-0 shadow-xs">
        <Building2 class="w-5 h-5" />
      </div>
    )}

    {/* Información del Puesto */}
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-(--text) leading-snug">
        {job.role}
      </h3>
      <div class="flex items-center gap-2 text-sm text-(--accent) font-medium mt-0.5">
        <Building2 class="w-3.5 h-3.5" />
        <span>{job.company}</span>
      </div>
    </div>
  </div>

  {/* Badges de Fecha y Ubicación alineados a la derecha en escritorio */}
  <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-(--text-muted) pl-14 sm:pl-0">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-(--border)/40 dark:border-white/5 bg-(--bg)/60 backdrop-blur-xs">
      <Calendar class="w-3 h-3 text-(--accent)" />
      {job.period}
    </span>
    {job.location && (
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-(--border)/40 dark:border-white/5 bg-(--bg)/60 backdrop-blur-xs">
        <MapPin class="w-3 h-3 text-(--text-muted)" />
        {job.location}
      </span>
    )}
  </div>
</div>

          {/* Lista de responsabilidades */}
          <ul class="mt-3 space-y-1.5 text-sm sm:text-base text-(--text-muted) list-disc list-inside marker:text-(--accent)">
            {job.description.map((point) => (
              <li class="leading-relaxed">{point}</li>
            ))}
          </ul>

          {/* Herramientas / Tecnologías utilizadas */}
          {job.tools.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-(--border)">
              {job.tools.map((tool) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-(--bg) border border-(--border) text-(--text-muted)">
                  {tool}
                </span>
              ))}
            </div>
          )}

        </div>

      </div>
    ))}
  </div>
</section>
