---
import Layout from '../layouts/Layout.astro';
import { LIST_PROJECTS } from "../data/proyects"; 
import { Github, ExternalLink, ArrowRight, Sparkles, ArrowLeft, FolderCode } from "lucide-astro";
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={`Proyectos | ${SITE_TITLE}`} description={SITE_DESCRIPTION} hideNavbar={true}>
  <main class="w-full max-w-3xl mx-auto px-4 py-2 flex flex-col gap-10">
    <div class="space-y-6 border-b border-(--border)/30 dark:border-white/5 pb-8">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-xs font-mono text-(--text-muted) hover:text-(--accent) transition-colors py-1 px-3 rounded-lg border border-(--border)/30 dark:border-white/5 bg-(--bg-surface) w-fit"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>Inicio</span>
      </a>

      {/* Título de la Página */}
      <div class="space-y-2">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-(--accent)">
          Proyectos
        </h1>
        <p class="text-sm text-(--text-muted) max-w-xl">
          Colección completa de sistemas, aplicaciones web y proyectos desarrollados.
        </p>
      </div>

    </div>

    {/* Rejilla de Proyectos en Columna Única (1 por fila) */}
    <div class="flex flex-col gap-8 w-full">
      {LIST_PROJECTS.map((project) => (
        <article class="p-6 rounded-2xl border border-(--border)/40 dark:border-white/5 bg-(--bg-surface) hover:bg-(--bg-card) hover:border-(--accent)/40 transition-all duration-300 shadow-xs flex flex-col sm:flex-row gap-6 group overflow-hidden">
          
          {/* Media: Imagen o Video (Columna izquierda en pantallas sm+) */}
          <div class="relative w-full sm:w-64 h-48 sm:h-auto shrink-0 rounded-xl overflow-hidden bg-(--bg) border border-(--border)/30 dark:border-white/5">
            {project.previewVideo ? (
              <video 
                src={project.previewVideo} 
                poster={project.image}
                muted 
                loop 
                playsinline
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onmouseenter="this.play()"
                onmouseleave="this.pause(); this.currentTime = 0;"
              />
            ) : (
              <img 
                src={project.image} 
                alt={project.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            )}

            {/* Badge 'Destacado' condicional */}
            {project.featured && (
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-lg border border-black/10 bg-black/60 backdrop-blur-md text-white text-[10px] font-mono flex items-center gap-1">
                <Sparkles class="w-3 h-3 text-(--accent)" />
                Featured
              </div>
            )}
          </div>

          {/* Detalles del Proyecto (Columna derecha) */}
          <div class="flex flex-col justify-between gap-4 flex-1">
            
            <div class="space-y-2">
              <h2 class="text-xl font-bold text-(--text) group-hover:text-(--accent) transition-colors">
                {project.title}
              </h2>
              <p class="text-xs sm:text-sm text-(--text-muted) leading-relaxed">
                {project.description}
              </p>
            </div>

            {/* Badges de Tecnologías */}
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-(--bg) border border-(--border)/30 dark:border-white/5 text-(--text-muted)">
                  {tag}
                </span>
              ))}
            </div>

            {/* Acciones: GitHub, Demo & Detalles */}
            <div class="flex items-center justify-between pt-3 border-t border-(--border)/30 dark:border-white/5">
              <div class="flex items-center gap-2">
                {project.githubUrl ? (
                  <a 
                    href={project.githubUrl} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    aria-label="Ver código en GitHub"
                    class="p-2 rounded-lg border border-(--border)/30 dark:border-white/5 bg-(--bg) text-(--text-muted) hover:text-(--text) hover:border-(--accent)/40 transition-all"
                  >
                    <Github class="w-4 h-4" />
                  </a>
                ) : (
                  <span class="text-[11px] font-mono text-(--text-muted)/60 italic px-1">Código Privado</span>
                )}

                {project.demoUrl && (
                  <a 
                    href={project.demoUrl} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    aria-label="Ver Demo en Vivo"
                    class="p-2 rounded-lg border border-(--border)/30 dark:border-white/5 bg-(--bg) text-(--text-muted) hover:text-(--accent) hover:border-(--accent)/40 transition-all"
                  >
                    <ExternalLink class="w-4 h-4" />
                  </a>
                )}
              </div>

              <a 
                href={`/projects/${project.id}`} 
                class="text-xs font-semibold text-(--accent) hover:underline flex items-center gap-1"
              >
                Ver detalles
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>

          </div>

        </article>
      ))}
    </div>

  </main>
</Layout>